# ==============================================================================
# SolarMind Backend Environment Configuration
# Copy this file to .env for local overrides. Never commit secrets or credentials.
# ==============================================================================

# Core Application Settings
PROJECT_NAME="SolarMind Backend"
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=development    # 'development', 'test', 'staging', 'production'
DEBUG=false
LOG_LEVEL=INFO             # 'DEBUG', 'INFO', 'WARNING', 'ERROR', 'CRITICAL'
DOCS_ENABLED=true          # Auto-disabled in production when unset

# Security & CORS (JSON array format)
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
SECRET_KEY=solarmind-insecure-secret-key-change-in-production-2026
MAX_REQUEST_BODY_BYTES=15728640  # 15 MB

# Database Configuration
# Local SQLite Prototype:
DATABASE_URL=sqlite:///./data/solarmind.db
# Production PostgreSQL Example:
# DATABASE_URL=postgresql://solarmind_user:secure_password@localhost:5432/solarmind_db

# Storage & Vision AI Pipeline
UPLOAD_DIR=uploads/photos
MAX_PHOTO_SIZE_BYTES=10485760    # 10 MB
VISION_MODEL_ENABLED=false
VISION_MODEL_PATH=

# Authentication, Cookie & Lockout Security
ACCESS_TOKEN_EXPIRE_MINUTES=1440 # 24 Hours
REMEMBER_ME_EXPIRE_DAYS=14
SESSION_COOKIE_NAME=solarmind_session
SESSION_COOKIE_SECURE=false      # Set to 'true' in production (HTTPS mandatory)
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax      # 'lax', 'strict', 'none'
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Initial Admin Provisioning (Run once on startup)
INITIAL_ADMIN_EMAIL=admin@solarmind.io
INITIAL_ADMIN_PASSWORD=SolarAdmin#2026!
INITIAL_ADMIN_FULL_NAME="SolarMind Administrator"

# Email Delivery Configuration (Optional)
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@solarmind.io

# External Inverter API Integrations (Optional)
DEYE_API_BASE_URL=https://india-developer.deyecloud.com:443
DEYE_APP_ID=
DEYE_APP_SECRET=
DEYE_EMAIL=
DEYE_PASSWORD=
